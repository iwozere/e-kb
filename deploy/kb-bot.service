[Unit]
Description=Personal Knowledge Base Bot
After=network.target postgresql.service

[Service]
Type=simple
User=kbbot
Group=kbbot
WorkingDirectory=/opt/kb-bot
EnvironmentFile=/opt/kb-bot/.env
ExecStart=/opt/kb-bot/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=5
# View logs: journalctl -u kb-bot -f

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/kb-bot /var/lib/kb-bot /tmp

[Install]
WantedBy=multi-user.target
